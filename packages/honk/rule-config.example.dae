# Based on qichiyuhub/rule config/honk/config.dae.
# Replace the placeholder URL and validate the profile and interfaces before enabling.
global {
  lan_interface: br-lan
  wan_interface: auto
  log_level: info
  bootstrap_resolver: '119.29.29.29:53'
}
subscription {
  # sub: 'REPLACE_WITH_YOUR_SUBSCRIPTION_URL' {
  #   ua: 'clash.meta/1.19.30'
  #   interval: 0s
  #   cache: false
  #   route: direct
  # }
}
dns {
  upstream {
    local: 'udp://127.0.0.1:53'
  }
  routing {
    request { fallback: local }
    response { fallback: local }
  }
}
routing {
  fallback: direct
}
